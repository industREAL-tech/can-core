<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>industREAL.CAN.CORE</PackageId>
    <Version>0.3.0</Version>
	  <!-- 0.2.0 is published on nuget.org and versions there are immutable, so the
	       merge of the hardware-timestamp work with the addressing fix needs its own.
	       Minor rather than patch: CanDeviceBase.FunctionMask widened from 0x0F to
	       0xFF, so a subclass that relied on a four-bit function field sees different
	       ownership. Nothing on this platform did, but it is a behaviour change. -->
    <Authors>industREAL</Authors>
    <Description>industREAL CAN Core package, including CAN Dispatcher</Description>
    <IsPackable>true</IsPackable>

    <PackProjectReferences>true</PackProjectReferences>

  </PropertyGroup>

  <!-- The SDK globs **/*.cs, which would pull the test project's sources into the
       library itself. Tests live in tests/ and build as their own project. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <PropertyGroup>
    <Company>industREAL.tech Ltd</Company>
    <Copyright>Copyright © 2026 industREAL.tech Ltd</Copyright>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/industREAL-tech/can-core</RepositoryUrl>
    <PackageProjectUrl>https://github.com/industREAL-tech/can-core</PackageProjectUrl>
    <PackageTags>industREAL;CAN;CAN-FD;CANbus;dispatcher</PackageTags>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
